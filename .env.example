# .env.example -> isko copy karke `.env` naam se rakhein (.env git me nahi jata)

# --- Local development ---
DJANGO_DEBUG=1

# --- Production (DJANGO_DEBUG=0 ya hata dein) ---
# Nayi secret key: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=shop.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
# DJANGO_HTTPS=1
# DJANGO_BEHIND_PROXY=1

# --- Email (alerts / Purchase Order). Khali ho to email console me print hota hai ---
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_TLS=1
# DJANGO_FROM_EMAIL=Vaultyfly <you@example.com>
# DJANGO_ALERT_EMAILS=owner@example.com
