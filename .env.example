# .env.example -> copy this file to `.env` (.env is not committed to git)

# --- Local development ---
DJANGO_DEBUG=1

# --- Production (DJANGO_DEBUG=0 or remove it) ---
# Generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=shop.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
# DJANGO_HTTPS=1
# DJANGO_BEHIND_PROXY=1

# --- Public home page (shown to visitors at /) ---
# DJANGO_WHATSAPP=919876543210

# --- Email (alerts / Purchase Order). If empty, emails are printed to the console ---
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_TLS=1
# DJANGO_FROM_EMAIL=MedSync <you@example.com>
# DJANGO_ALERT_EMAILS=owner@example.com

# --- PostgreSQL (optional). Leave DB_NAME empty to keep using SQLite (db.sqlite3) ---
# DB_NAME=inventory_db
# DB_USER=inventory_user
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# Backups on PostgreSQL use pg_dump. If it is not on the PATH, give its full path:
# PG_DUMP=C:/Program Files/PostgreSQL/17/bin/pg_dump.exe

# --- Many shops in one install (optional; needs PostgreSQL above) ---
# MULTI_SHOP=1
# SHOP_BASE_DOMAIN=localhost          # shops open at <name>.<this domain>; on the server: medsync.socialflylive.com
# TRIAL_DAYS=30
# SIGNUP_SKIP_EMAIL=1                 # TESTING ONLY: sign-up skips the email check. Never on the live server.
